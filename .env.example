# Copy this file to .env and fill in your real values.
# Never commit .env — it is listed in .gitignore.

# Anthropic API key for Claude-powered evidence extraction and scoring
ANTHROPIC_API_KEY=your_key_here

# Shared secret required in the X-Demo-Key header on POST /analyze.
# Leave unset for local development — auth is skipped entirely when this is empty.
# Set on the public deployment to gate access to the live demo.
DEMO_ACCESS_CODE=

# Optional — daily analysis caps enforced when DEMO_ACCESS_CODE is set.
# Defaults shown; only need to be set to override them.
# RATE_LIMIT_PER_IP_PER_DAY=5
# RATE_LIMIT_GLOBAL_PER_DAY=30

# Optional — comma-separated list of extra allowed CORS origins
# (e.g. the deployed Vercel frontend URL), in addition to localhost dev ports.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional — path to the SQLite audit database. Defaults to data/audit.db.
# AUDIT_DB_PATH=data/audit.db
